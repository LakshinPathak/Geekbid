# ─────────────────────────────────────────────────
# GeekBid Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# MongoDB Atlas Connection (required)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/geekbid?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret — MUST be identical to the web app's NEXTAUTH_SECRET so that
# access tokens minted by the Next.js BFF verify in these services.
# Generate with: openssl rand -base64 32  (then set the same value in web/.env.local)
JWT_SECRET=

# Razorpay Test Mode Keys
# Get your test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Service Ports (defaults shown — override if needed)
# NOTE: the gateway must NOT use 3000 — that port belongs to the Next.js web app.
GATEWAY_PORT=8080
# Comma-separated origins allowed to call the gateway directly (BFF is same-origin;
# this is only a backstop). Include the web app origin.
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_PORT=3001
JOB_PORT=3003
BIDDING_PORT=3004
PAYMENT_PORT=3005
NOTIFICATION_PORT=3006
CHAT_PORT=3007
