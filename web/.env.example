# ─────────────────────────────────────────────────
# GeekBid Web (Next.js) — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────

# MongoDB Atlas Connection
MONGODB_URI=

# NextAuth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Razorpay Plans (https://dashboard.razorpay.com/app/subscriptions/plans) —
# create a monthly plan per paid tier matching the prices in lib/plans.ts
# ($19 Plus, $79 Premium) before Phase 4 subscription checkout can go live.
# Until these are set, /api/subscriptions runs in mock mode.
RAZORPAY_PLAN_ID_PLUS=
RAZORPAY_PLAN_ID_PREMIUM=

# Set to "true" only for a staging/demo env that runs with NODE_ENV=production
# but has no real Razorpay plans configured — allows /api/subscriptions to
# fall back to mock (free) activation there. Never set this on real prod.
ALLOW_MOCK_BILLING=

# Shared secret for Vercel Cron requests to /api/cron/* routes — generate with:
# openssl rand -base64 32
CRON_SECRET=

# Cloudinary (https://console.cloudinary.com/settings/api-keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# API key is not secret (paired with CLOUDINARY_API_SECRET, which is) —
# the upload widget needs it client-side to do signed uploads via
# /api/upload/sign (AvatarUploader.tsx).
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# No longer used — avatar uploads are signed (api/upload/sign) instead of
# going through an unsigned preset. Delete/disable the "geekbid_unsigned"
# preset on the Cloudinary dashboard so it can't be used directly either.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Google Gemini AI (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Admin panel access key — separate from any user's login password.
# Read at request time (not build time) by the admin routes — e.g.
# web/src/app/api/admin/verify-key/route.ts and api/admin/users/route.ts,
# via constantTimeEqual(key, process.env.ADMIN_SECRET_KEY ?? ""). Nothing
# throws at build/startup if this is unset; it just fails every admin-key
# check closed (empty string never matches a non-empty submitted key).
# Still must be set in every real deployment or the admin panel is unusable.
ADMIN_SECRET_KEY=

# Resend (https://resend.com/api-keys) — transactional emails
RESEND_API_KEY=

# NOTE: this list must stay in sync with the ARGs declared in web/Dockerfile
# and the `build` job's env block in .github/workflows/ci.yml — `next build`
# imports every route module, so a missing var here can mean a silent
# Cloudinary/AI/email failure or an unset admin key that only surfaces at
# runtime instead of at setup time.
