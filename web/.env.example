# ─────────────────────────────────────────────────
# GeekBid Web (Next.js) — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────

# MongoDB Atlas Connection
MONGODB_URI=

# NextAuth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Cloudinary (https://console.cloudinary.com/settings/api-keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Google Gemini AI (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Admin panel access key — separate from any user's login password.
# Required at build time: web/src/lib/auth.ts and the admin routes throw if unset.
ADMIN_SECRET_KEY=

# Resend (https://resend.com/api-keys) — transactional emails
RESEND_API_KEY=

# NOTE: this list must stay in sync with the ARGs declared in web/Dockerfile
# and the `build` job's env block in .github/workflows/ci.yml — `next build`
# imports every route module, so a missing var here can mean a silent
# Cloudinary/AI/email failure or an unset admin key that only surfaces at
# runtime instead of at setup time.
